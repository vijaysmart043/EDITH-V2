# ==============================================================================
# EDITH Environment Configuration
# Enhanced Digital Intelligence & Task Handler
# Developed by G.Vijay Raj (vijay smart)
# ==============================================================================

# Google Gemini API Key for natural language understanding & conversational answers
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g. gemini-2.5-flash, gemini-1.5-pro, gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Assistant Settings
EDITH_ENV=production
EDITH_LOG_LEVEL=INFO
EDITH_WAKE_WORD="Hey EDITH"
EDITH_VOICE_RATE=180
EDITH_CONVERSATION_TIMEOUT=10

# Security Configuration
REQUIRE_CONFIRMATION_FOR_DANGEROUS=true
ENABLE_ADVANCED_AUTOMATION=false
ALLOW_FILE_OPERATIONS=true
DRY_RUN_MODE=false
